# Copy to .env (repo root) and fill in what you use. Never commit .env.
# The cut → clean → TSX → SFX core needs AssemblyAI + ElevenLabs; Gemini is only for thumbnails.
# yt_upload / yt_stats use OAuth, not a key here (see tools/yt_upload_SETUP.md and CLAUDE.md).

# AssemblyAI — transcription for the cut pipeline (tools/transcribe.py). Required for /clean-cut.
# https://assemblyai.com
ASSEMBLYAI_API_KEY=

# ElevenLabs — voice isolation (tools/clean_voice.py --method eleven), SFX generation
# (tools/gen_sfx.py), and music beds (tools/gen_music.py). Needed for /clean-audio + /suggest-sfx.
# /clean-audio's local RNNoise method needs no key if you would rather skip this one.
# https://elevenlabs.io
ELEVENLABS_API_KEY=

# Google Gemini — thumbnail generation with Nano Banana Pro (tools/gen_thumbnail.py, /packaging).
# Only needed if you render thumbnails.
# https://ai.google.dev
GEMINI_API_KEY=

# fal.ai — generated video clips (tools/gen_video.py). Only needed for beats TSX cannot fake:
# physical gags, presenter-likeness inserts, the simulated-avatar ladder. Image-to-video is
# billed per second of output (kling 2.5 turbo pro ~$0.07/s, seedance ~$0.05/s, veo 3.1 ~$0.20/s),
# so a 5s attempt is cents and you can iterate. `python tools/gen_video.py --list-models`.
# https://fal.ai/dashboard/keys
# Also used by tools/gen_image.py (generated stills, ~$0.15 each) and tools/cutout.py (cutouts).
FAL_KEY=

# Notion — the content tracker (tools/notion_sync.py). Optional; nothing else uses it.
# NOTION_TOKEN is an internal integration secret (https://notion.so/my-integrations), and the
# integration must be shared into the page below. NOTION_LONGS_PAGE_ID is the *page* that holds
# the "YouTube Videos" database (not the database id) — copy it from the page URL.
NOTION_TOKEN=
NOTION_LONGS_PAGE_ID=
